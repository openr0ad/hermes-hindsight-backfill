# Copy to config.env (git-ignored) and edit. Real environment variables take
# precedence over values in this file. Point at another file with WEBUI_CONFIG.

# Path to the Hermes session database.
#   Pi (production):  ~/.hermes/state.db   (the default if unset)
#   Windows (dev):    ./dev-data/state.db
HERMES_DB=~/.hermes/state.db

# Hindsight API base URL (the API port, not the Control Plane UI port).
HINDSIGHT_API_URL=http://localhost:8888

# Optional bearer token if your Hindsight API requires one.
# HINDSIGHT_API_KEY=

# Memory bank to write to / check for duplicates.
HINDSIGHT_BANK=hermes

# Web UI bind address and port. 0.0.0.0 = reachable from the LAN (no auth!).
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8765
